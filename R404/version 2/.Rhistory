# =================== CONFIGURATION ===================
KERNELS <- c("rectangular", "epanechnikov", "biweight", "triangular", "gaussian")
BW_RULES <- c("nrd0", "SJ", "ucv")
X_LIM_DAILY <- c(-0.05, 0.05)
X_LIM_WEEKLY <- c(-0.05, 0.05)
