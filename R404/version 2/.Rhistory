'boardgender_average': (-0.0001, 0.0001)
}
# ============================================================================
# DATA LOADING AND PREPROCESSING
# ============================================================================
def load_and_convert_data(filepath):
"""Load CSV and convert ticker-related columns to numeric."""
df = pd.read_csv(filepath)
for ticker in TICKERS:
for col_suffix in ['', '_ceoage', '_ceotenor', '_boardage', '_boardtenor', '_boardgender']:
col_name = f'{ticker}{col_suffix}' if col_suffix else ticker
if col_name in df.columns:
df[col_name] = pd.to_numeric(df[col_name], errors='coerce')
print("Data types after conversion:")
print(df.dtypes)
return df
def calculate_averages(df, tickers, attributes):
"""Calculate average values for each attribute across included tickers."""
# Initialize average columns
for attr in attributes:
df[f'{attr}_average'] = 0.0
# Calculate sums
for ticker in tickers:
include_col = f'include_{ticker}'
if include_col not in df.columns:
continue
mask = df[include_col] == 1
for attr in attributes:
attr_col = f'{attr}_{ticker}'
if attr_col in df.columns:
df[f'{attr}_average'] += df[attr_col].where(mask, 0)
# Calculate number of included tickers
include_cols = [f'include_{ticker}' for ticker in tickers if f'include_{ticker}' in df.columns]
include_counts = df[include_cols].sum(axis=1).replace(0, np.nan)
# Divide by counts to get averages
for attr in attributes:
df[f'{attr}_average'] = df[f'{attr}_average'] / include_counts
return df
# ============================================================================
# REGRESSION ANALYSIS
# ============================================================================
def perform_ols_analysis(X_train, y_train, output_path):
"""Perform OLS regression and calculate VIF."""
X_ols = sm.add_constant(X_train)
model = sm.OLS(y_train, X_ols).fit()
# Calculate VIF
X_VIF = X_ols.iloc[:, 1:]
vif = pd.DataFrame({
"Feature": X_VIF.columns,
"VIF": [variance_inflation_factor(X_VIF.values, i) for i in range(X_VIF.shape[1])]
})
print("\nVIF for OLS model:\n", vif)
print(model.summary())
# Extract and save OLS coefficients
ols_coefficients = pd.DataFrame({
'Variable': model.params.index,
'Coefficient': model.params.values,
'Std Error': model.bse.values,
't-statistic': model.tvalues.values,
'p-value': model.pvalues.values,
'Conf Int Lower': model.conf_int()[0].values,
'Conf Int Upper': model.conf_int()[1].values
})
# Add significance stars
ols_coefficients['Significance'] = ols_coefficients['p-value'].apply(
lambda p: '***' if p < 0.001 else '**' if p < 0.01 else '*' if p < 0.05 else '.'  if p < 0.1 else ''
)
print("\n" + "="*80)
print("OLS COEFFICIENTS:")
print("="*80)
print(ols_coefficients.to_string(index=False))
print("\nSignificance codes: 0 '***' 0.001 '**' 0.01 '*' 0.05 '.' 0.1 ' ' 1")
# Save to CSV
ols_coefficients.to_csv(output_path / 'ols_coefficients.csv', index=False)
print(f"\nOLS coefficients saved to: {output_path / 'ols_coefficients.csv'}")
return model
def perform_regularized_regression(X_train, y_train, X_test, y_test):
"""Perform Lasso and Ridge regression with cross-validation."""
alphas = np.logspace(-4, 1, 50)
results = {}
# Lasso
lasso_cv = LassoCV(alphas=alphas, cv=5, max_iter=10000, n_jobs=-1, random_state=42)
lasso_cv.fit(X_train, y_train)
lasso_rmse = mean_squared_error(y_test, lasso_cv.predict(X_test)) ** 0.5
results['lasso'] = {
'model': lasso_cv,
'alpha': lasso_cv.alpha_,
'rmse': lasso_rmse,
'coef': pd.Series(lasso_cv.coef_, index=X_train.columns)
}
print(f"\nLasso best alpha: {lasso_cv.alpha_:.6g}")
print(f"Lasso test RMSE: {lasso_rmse:.4f}")
# Ridge
ridge_cv = RidgeCV(alphas=alphas, scoring='neg_mean_squared_error', cv=5)
ridge_cv.fit(X_train, y_train)
ridge_rmse = mean_squared_error(y_test, ridge_cv.predict(X_test)) ** 0.5
results['ridge'] = {
'model': ridge_cv,
'alpha': ridge_cv.alpha_,
'rmse': ridge_rmse,
'coef': pd.Series(ridge_cv.coef_, index=X_train.columns)
}
print(f"\nRidge best alpha: {ridge_cv.alpha_:.6g}")
print(f"Ridge test RMSE: {ridge_rmse:.4f}")
return results
def plot_regression_results(df, model_ols, model_ridge, model_lasso, X_test, y_test):
"""Generate all regression plots."""
df['Date'] = pd.to_datetime(df['Date'], format='%Y.%m.%d')
test_dates = df.loc[X_test.index, 'Date']
log_actual = y_test
# Get predictions
X_test_ols = sm.add_constant(X_test)
predictions = {
'OLS': model_ols.predict(X_test_ols),
'Ridge': model_ridge.predict(X_test),
'Lasso': model_lasso.predict(X_test)
}
# Prepare results DataFrame
results = pd.DataFrame({
'Date': test_dates,
'Actual (log)': log_actual,
**{f'{name} Predictions': pred for name, pred in predictions.items()}
}).sort_values('Date')
# Calculate errors
for name in predictions.keys():
results[f'{name} Error'] = results['Actual (log)'] - results[f'{name} Predictions']
# Combined plot
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(16, 10))
# Predictions
ax1.plot(results['Date'], results['Actual (log)'], label='Actual (log)', color='black', linewidth=2)
colors = {'OLS': 'blue', 'Ridge': 'red', 'Lasso': 'green'}
for name, color in colors.items():
ax1.plot(results['Date'], results[f'{name} Predictions'],
label=f'{name} Predictions', color=color, linestyle='--')
ax1.set_title('Actual (log) vs Predicted MBI10 (log) Values')
ax1.set_xlabel('Date')
ax1.set_ylabel('log(MBI10)')
ax1.legend()
ax1.grid(True)
ax1.tick_params(axis='x', rotation=45)
# Errors
for name, color in colors.items():
ax2.plot(results['Date'], results[f'{name} Error'], label=f'{name} Error', color=color)
ax2.axhline(y=0, color='black', linestyle='--')
ax2.set_title('Prediction Errors (Actual – Predicted) on Log Scale')
ax2.set_xlabel('Date')
ax2.set_ylabel('Error (log scale)')
ax2.legend()
ax2.grid(True)
ax2.tick_params(axis='x', rotation=45)
plt.tight_layout()
plt.savefig(OUTPUT_PATH / 'combined_predictions_and_errors.pdf')
plt.close()
# Error metrics
error_metrics = {}
for name in predictions.keys():
errors = results[f'{name} Error']
error_metrics[name] = {
'MAE': np.mean(np.abs(errors)),
'RMSE': np.sqrt(np.mean(errors**2)),
'Mean Error': np.mean(errors),
'Median Error': np.median(errors),
'Error Std Dev': np.std(errors)
}
error_df = pd.DataFrame.from_dict(error_metrics, orient='index')
print("\nDetailed Error Metrics (log scale):")
print(error_df)
error_df.to_csv(OUTPUT_PATH / 'error_metrics.csv')
return results
# ============================================================================
# VOLATILITY ANALYSIS
# ============================================================================
def prepare_volatility_data(df, quantile_ranges):
"""Prepare data for volatility event prediction."""
# Calculate returns
df['MBI10_daily_return'] = df['MBI10'].pct_change()
# Define volatility events
percentile_05 = df['MBI10_daily_return'].quantile(0.025)
percentile_95 = df['MBI10_daily_return'].quantile(0.975)
df['volatility_event'] = np.where(
(df['MBI10_daily_return'] < percentile_05) | (df['MBI10_daily_return'] > percentile_95),
1, 0
)
print(f"\nNumber of volatility events: {df['volatility_event'].sum()}")
# Create change flags
change_flags = pd.DataFrame(index=df.index)
for column, (q_low, q_high) in quantile_ranges.items():
df[f'{column}_pct_change'] = df[column].pct_change()
change_flags[f'flag_{column}'] = np.where(
(df[f'{column}_pct_change'] <= q_low) | (df[f'{column}_pct_change'] >= q_high),
1, 0
)
print(f"Number of flags for {column}: {change_flags[f'flag_{column}'].sum()}")
print(f"{column} - Low: {q_low:.4f}, High: {q_high:.4f}")
return df, change_flags
def train_classification_models(X_train, X_test, y_train, y_test, feature_names, output_path):
"""Train and evaluate multiple classification models."""
models = {
'Logistic Regression': LogisticRegression(random_state=42, max_iter=1000),
'Decision Tree': DecisionTreeClassifier(random_state=42),
'SVM': SVC(random_state=42),
'Neural Network': MLPClassifier(random_state=42, max_iter=500),
'QDA': QuadraticDiscriminantAnalysis()
}
results = {}
for name, model in models.items():
try:
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
accuracy = accuracy_score(y_test, y_pred)
results[name] = {
'model': model,
'accuracy': accuracy,
'predictions': y_pred
}
print(f"\n{name} Accuracy: {accuracy:.4f}")
print(f"{name} Classification Report:\n{classification_report(y_test, y_pred)}")
# Extract and save Logistic Regression coefficients with p-values
if name == 'Logistic Regression':
# Use statsmodels for p-values
X_train_const = sm.add_constant(X_train)
logit_model = sm.Logit(y_train, X_train_const).fit(disp=0)
# Create coefficient DataFrame
logit_coefficients = pd.DataFrame({
'Variable': ['Intercept'] + list(feature_names),
'Coefficient': logit_model.params.values,
'Std Error': logit_model.bse.values,
'z-statistic': logit_model.tvalues.values,
'p-value': logit_model.pvalues.values,
'Conf Int Lower': logit_model.conf_int()[0].values,
'Conf Int Upper': logit_model.conf_int()[1].values
})
# Add odds ratios
logit_coefficients['Odds Ratio'] = np.exp(logit_coefficients['Coefficient'])
# Add significance stars
logit_coefficients['Significance'] = logit_coefficients['p-value'].apply(
lambda p: '***' if p < 0.001 else '**' if p < 0.01 else '*' if p < 0.05 else '.' if p < 0.1 else ''
)
print("\n" + "="*80)
print("LOGISTIC REGRESSION COEFFICIENTS:")
print("="*80)
print(logit_coefficients.to_string(index=False))
print("\nSignificance codes: 0 '***' 0.001 '**' 0.01 '*' 0.05 '.' 0.1 ' ' 1")
print("\nModel Summary:")
print(f"Pseudo R-squared: {logit_model.prsquared:.4f}")
print(f"Log-Likelihood: {logit_model.llf:.4f}")
print(f"AIC: {logit_model.aic:.4f}")
print(f"BIC: {logit_model.bic:.4f}")
# Save to CSV
logit_coefficients.to_csv(output_path / 'logistic_regression_coefficients.csv', index=False)
print(f"\nLogistic Regression coefficients saved to: {output_path / 'logistic_regression_coefficients.csv'}")
# Save model summary
with open(output_path / 'logistic_regression_summary.txt', 'w') as f:
f.write(logit_model.summary().as_text())
print(f"Logistic Regression full summary saved to: {output_path / 'logistic_regression_summary.txt'}")
except Exception as e:
print(f"Error training {name}: {e}")
return results
def plot_volatility_histograms(df, quantile_ranges, output_path):
"""Generate histograms for percentage changes."""
for column, (q_low, q_high) in quantile_ranges.items():
pct_col = f'{column}_pct_change'
if pct_col not in df.columns:
continue
data = df[pct_col].dropna()
if data.empty:
continue
plt.figure(figsize=(10, 6))
# Calculate bins
num_bins = max(1, len(data) // 10)
counts, bin_edges = np.histogram(data, bins=num_bins)
relative_counts = counts / counts.sum() * 100
# Plot histogram
bar_width = np.diff(bin_edges)
plt.bar(bin_edges[1:], relative_counts, width=bar_width,
edgecolor='black', align='edge', alpha=0.7)
# Add KDE
sns.kdeplot(data, color='blue', label='KDE', alpha=0.5)
# Add threshold lines
plt.axvline(q_low, color='red', linestyle='--', label=f'Low: {q_low:.4f}')
plt.axvline(q_high, color='green', linestyle='--', label=f'High: {q_high:.4f}')
plt.title(f'{column} Percentage Change Distribution')
plt.ylabel('Relative Frequency (%)')
plt.xlabel('Percentage Change')
plt.ylim(0, max(relative_counts) + 5)
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.legend()
plt.tight_layout()
plt.savefig(output_path / f'{column}_histogram.pdf')
plt.close()
# ============================================================================
# KNN CLUSTERING ANALYSIS
# ============================================================================
def perform_knn_clustering(data, original_idx, n_neighbors=5):
"""Perform KNN clustering on scaled data."""
scaler = StandardScaler()
scaled = scaler.fit_transform(data)
n_neighbors = min(n_neighbors, len(scaled))
nn = NearestNeighbors(n_neighbors=n_neighbors)
nn.fit(scaled)
distances, indices = nn.kneighbors(scaled)
return distances, indices, scaled, original_idx
def build_ticker_data(df, ticker_list, attribute, date_numeric):
"""Build data arrays for specified tickers."""
data_blocks, idx_blocks = [], []
for ticker in ticker_list:
inc_col = f"include_{ticker}"
if inc_col not in df.columns:
continue
mask = df[inc_col] == 1
if not mask.any():
continue
attr_col = f"{attribute}_{ticker}"
if attr_col not in df.columns:
continue
vals = df.loc[mask, attr_col]
if vals.empty or vals.isna().all():
continue
data_blocks.append(np.column_stack([date_numeric[mask].values, vals.values]))
idx_blocks.append(mask[mask].index)
if not data_blocks:
return None, None, None
data_arr = np.concatenate(data_blocks)
idx_arr = pd.Index(np.concatenate(idx_blocks))
return data_arr, idx_arr, idx_blocks
def compute_knn_sizes(data_arr, idx_arr):
"""Compute point sizes based on KNN distances."""
if data_arr is None:
return pd.Series(dtype=float)
distances, _, _, _ = perform_knn_clustering(data_arr, idx_arr)
dist_mean = distances.mean(axis=1)
size_series = pd.Series(50 + dist_mean * 100, index=idx_arr)
return size_series.groupby(size_series.index).mean()
def plot_combined_knn(attribute, df, output_path):
"""Create combined KNN visualization."""
df['Date'] = pd.to_datetime(df['Date'], format='%Y.%m.%d', errors='coerce')
date_numeric = (df["Date"] - df["Date"].min()).dt.days
present_tickers = [c.split("_", 1)[1] for c in df.columns if c.startswith("include_")]
non_banking = [t for t in present_tickers if t not in BANKING_TICKERS]
domestic = [t for t in present_tickers if t not in FOREIGN_CAPITAL_TICKERS]
# Build data for each group
banking_data, banking_idx, _ = build_ticker_data(df, BANKING_TICKERS, attribute, date_numeric)
nonbank_data, nonbank_idx, _ = build_ticker_data(df, non_banking, attribute, date_numeric)
foreign_data, foreign_idx, _ = build_ticker_data(df, FOREIGN_CAPITAL_TICKERS, attribute, date_numeric)
domestic_data, domestic_idx, _ = build_ticker_data(df, domestic, attribute, date_numeric)
# Compute sizes
size_map = {
"banking": compute_knn_sizes(banking_data, banking_idx),
"nonbank": compute_knn_sizes(nonbank_data, nonbank_idx),
"foreign": compute_knn_sizes(foreign_data, foreign_idx),
"domestic": compute_knn_sizes(domestic_data, domestic_idx),
}
# Calculate group averages
averages = pd.DataFrame(index=df.index)
for group_name, ticker_list in [('banking', BANKING_TICKERS),
('nonbank', non_banking),
('foreign', FOREIGN_CAPITAL_TICKERS),
('domestic', domestic)]:
cols = [f"{attribute}_{t}" for t in ticker_list if f"{attribute}_{t}" in df.columns]
if cols:
averages[f"{attribute}_average_{group_name}"] = df[cols].mean(axis=1)
# Plot
plt.figure(figsize=(14, 8))
common_idx = averages.dropna(how='all').index
if common_idx.empty:
print(f"No data to plot for {attribute}")
plt.close()
return
x = date_numeric.loc[common_idx]
colors = {'banking': 'blue', 'nonbank': 'orange', 'foreign': 'green', 'domestic': 'red'}
for group, color in colors.items():
col = f"{attribute}_average_{group}"
if col in averages.columns:
sizes = size_map[group].reindex(common_idx).fillna(50).values
plt.scatter(x, averages.loc[common_idx, col], s=sizes,
label=group.capitalize(), color=color, alpha=0.6)
plt.title(f"KNN Combined Analysis: {attribute}")
plt.xlabel("Date")
plt.ylabel("Average Attribute Values")
plt.xticks(rotation=45)
plt.legend(title="Group")
plt.tight_layout()
plt.savefig(output_path / f'{attribute}_combined_knn.pdf')
plt.close()
# ============================================================================
# MAIN EXECUTION
# ============================================================================
def main():
"""Main execution function."""
print("="*80)
print("LOADING AND PREPROCESSING DATA")
print("="*80)
# Load data
df = load_and_convert_data(INPUT_FILE)
df = calculate_averages(df, TICKERS, ATTRIBUTES)
# Export averages
df.to_csv(BASE_PATH / 'input_csv_averages.csv', index=False)
print(f"Averages exported.")
# Prepare target variable
y = df['MBI10'].pct_change() * 100
# Drop NaNs from y and align X accordingly
valid_idx = y.dropna().index
y = y.loc[valid_idx]
# Assuming macro factors are columns in df
macro_factors = ['CPI', 'M2', 'IR']
feature_cols = [f'{attr}_average' for attr in ATTRIBUTES] + macro_factors
# Ensure all feature columns exist
feature_cols = [col for col in feature_cols if col in df.columns]
X = df.loc[valid_idx, feature_cols]
# Standardize features
scaler = StandardScaler()
X_scaled = pd.DataFrame(scaler.fit_transform(X), columns=X.columns, index=X.index)
# Split data
X_train, X_test, y_train, y_test = train_test_split(
X_scaled, y, test_size=0.2, random_state=42
)
# OLS
model_ols = perform_ols_analysis(X_train, y_train, OUTPUT_PATH)
# Regularized regression
reg_results = perform_regularized_regression(X_train, y_train, X_test, y_test)
# Plots
plot_regression_results(df, model_ols,
reg_results['ridge']['model'],
reg_results['lasso']['model'],
X_test, y_test)
# ========================================================================
# VOLATILITY ANALYSIS
# ========================================================================
print("\n" + "="*80)
print("VOLATILITY ANALYSIS")
print("="*80)
df, change_flags = prepare_volatility_data(df, QUANTILE_RANGES)
# Prepare classification data
X_vol = change_flags
y_vol = df['volatility_event']
scaler_vol = StandardScaler()
X_vol_scaled = pd.DataFrame(scaler_vol.fit_transform(X_vol),
columns=X_vol.columns, index=X_vol.index)
X_train_vol, X_test_vol, y_train_vol, y_test_vol = train_test_split(
X_vol_scaled, y_vol, test_size=0.2, random_state=42
)
# Train models
classification_results = train_classification_models(
X_train_vol, X_test_vol, y_train_vol, y_test_vol,
X_vol.columns, OUTPUT_PATH
)
# Plot histograms
plot_volatility_histograms(df, QUANTILE_RANGES, OUTPUT_PATH)
# Export volatility data
final_df = df[['MBI10_daily_return', 'volatility_event']].copy()
for column in QUANTILE_RANGES.keys():
final_df[column] = df[column]
final_df[f'{column}_pct_change'] = df[f'{column}_pct_change']
final_df[f'flag_{column}'] = change_flags[f'flag_{column}']
final_df.to_csv(BASE_PATH / 'volatility_analysis.csv', index=False)
# ========================================================================
# KNN CLUSTERING
# ========================================================================
print("\n" + "="*80)
print("KNN CLUSTERING ANALYSIS")
print("="*80)
for attr in ATTRIBUTES:
try:
plot_combined_knn(attr, df, OUTPUT_PATH)
except Exception as e:
print(f"Error in KNN plot for {attr}: {e}")
print("\n" + "="*80)
print("ANALYSIS COMPLETE")
print("="*80)
print("\nGenerated files:")
print(f"  - {OUTPUT_PATH / 'ols_coefficients.csv'}")
print(f"  - {OUTPUT_PATH / 'logistic_regression_coefficients.csv'}")
print(f"  - {OUTPUT_PATH / 'logistic_regression_summary.txt'}")
print(f"  - Other visualization and analysis files...")
if __name__ == "__main__":
main()
